-- UC 1: Create and Initialize Database
CREATE DATABASE payroll_service;
GO
USE payroll_service;
GO
-- Verify DB existence via MSSQL master catalog
SELECT name FROM sys.databases WHERE name = 'payroll_service';
GO

-- UC 2: Create Base Table
CREATE TABLE employee_payroll (
    id INT IDENTITY(1,1) PRIMARY KEY, -- IDENTITY handles Auto-Increment in MSSQL
    name VARCHAR(150) NOT NULL,
    salary DECIMAL(18, 2) NOT NULL,   -- DECIMAL is safer for financial data than DOUBLE
    start_date DATE NOT NULL
);
GO

-- UC 3: CRUD - Insert Data
INSERT INTO employee_payroll (name, salary, start_date) VALUES 
('Bill', 50000.00, '2018-01-01'),
('Terissa', 60000.00, '2019-05-10'),
('Charlie', 70000.00, '2020-11-15');
GO

-- UC 4: CRUD - Read All Data
SELECT * FROM employee_payroll;
GO

-- UC 5: Parameterized Filters & Built-in Functions
SELECT salary FROM employee_payroll WHERE name = 'Bill';

SELECT * FROM employee_payroll 
WHERE start_date BETWEEN CAST('2018-01-01' AS DATE) AND GETDATE(); -- GETDATE() replaces NOW() in MSSQL
GO

-- UC 6: Alter Schema & Update Records
ALTER TABLE employee_payroll ADD gender CHAR(1);
GO
UPDATE employee_payroll SET gender = 'M' WHERE name IN ('Bill', 'Charlie');
UPDATE employee_payroll SET gender = 'F' WHERE name = 'Terissa';
GO

-- UC 7: Aggregate Grouped Analysis
SELECT gender, 
       SUM(salary) AS Total_Salary, 
       AVG(salary) AS Average_Salary, 
       MIN(salary) AS Min_Salary, 
       MAX(salary) AS Max_Salary, 
       COUNT(id) AS Total_Employees 
FROM employee_payroll 
GROUP BY gender;
GO