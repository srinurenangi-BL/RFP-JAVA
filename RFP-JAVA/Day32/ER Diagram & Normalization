-- UC 11 & 12: Creating the Normalized Infrastructure
CREATE TABLE Company_Employee (
    EmployeeID INT IDENTITY(1,1) PRIMARY KEY,
    EmployeeName VARCHAR(150) NOT NULL,
    Gender CHAR(1) NOT NULL,
    Phone VARCHAR(15),
    Address VARCHAR(255) DEFAULT 'Not Provided',
    StartDate DATE NOT NULL
);

CREATE TABLE Department (
    DepartmentID INT IDENTITY(1,1) PRIMARY KEY,
    DepartmentName VARCHAR(100) NOT NULL UNIQUE
);

-- Many-to-Many junction mapping table
CREATE TABLE Employee_Department (
    EmployeeID INT FOREIGN KEY REFERENCES Company_Employee(EmployeeID),
    DepartmentID INT FOREIGN KEY REFERENCES Department(DepartmentID),
    PRIMARY KEY (EmployeeID, DepartmentID)
);

CREATE TABLE Payroll (
    EmployeeID INT UNIQUE FOREIGN KEY REFERENCES Company_Employee(EmployeeID),
    BasicPay DECIMAL(18,2) NOT NULL,
    Deductions DECIMAL(18,2) NOT NULL,
    TaxablePay DECIMAL(18,2) NOT NULL,
    IncomeTax DECIMAL(18,2) NOT NULL,
    NetPay DECIMAL(18,2) NOT NULL
);
