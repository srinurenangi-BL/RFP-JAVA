-- USE CASE 1: Create the payroll service database
CREATE DATABASE payroll_service;
SHOW DATABASES;
USE payroll_service;


-- USE CASE 2: Create the employee payroll table
CREATE TABLE employee_payroll (
    id INT NOT NULL AUTO_INCREMENT,
    name VARCHAR(150) NOT NULL,
    salary DOUBLE NOT NULL,
    start_date DATE NOT NULL,
    PRIMARY KEY (id)
);


-- USE CASE 3: Insert initial employee records (CRUD - Create)
INSERT INTO employee_payroll (name, salary, start_date) VALUES 
('Bill', 50000.00, '2018-01-01'),
('Terissa', 60000.00, '2019-05-10'),
('Charlie', 70000.00, '2020-11-15');


-- USE CASE 4: Retrieve all employee payroll data (CRUD - Read)
SELECT * FROM employee_payroll;


-- USE CASE 5: Retrieve salary for a specific employee and filter by date range
-- Get Bill's salary
SELECT salary FROM employee_payroll WHERE name = 'Bill';

-- Get employees who joined within a specific date range
SELECT * FROM employee_payroll 
WHERE start_date BETWEEN CAST('2018-01-01' AS DATE) AND DATE(NOW());


-- USE CASE 6: Add Gender column and update existing rows
ALTER TABLE employee_payroll ADD gender CHAR(1) AFTER name;

-- Update rows to assign correct gender
UPDATE employee_payroll SET gender = 'M' WHERE name = 'Bill' OR name = 'Charlie';
UPDATE employee_payroll SET gender = 'F' WHERE name = 'Terissa';


-- USE CASE 7: Database analytics using aggregate functions group by gender
SELECT gender, SUM(salary) AS total_salary FROM employee_payroll GROUP BY gender;
SELECT gender, AVG(salary) AS avg_salary FROM employee_payroll GROUP BY gender;
SELECT gender, MIN(salary) AS min_salary FROM employee_payroll GROUP BY gender;
SELECT gender, MAX(salary) AS max_salary FROM employee_payroll GROUP BY gender;
SELECT gender, COUNT(id) AS employee_count FROM employee_payroll GROUP BY gender;