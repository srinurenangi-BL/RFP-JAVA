-- UC 1: Setup Schema Container
CREATE DATABASE payroll_service;
USE payroll_service;

-- UC 2: Instantiate Base Flat Collection Table
CREATE TABLE employee_payroll (
    id INT NOT NULL AUTO_INCREMENT,
    name VARCHAR(150) NOT NULL,
    salary DECIMAL(10,2) NOT NULL, 
    start_date DATE NOT NULL,
    PRIMARY KEY (id)
);

-- UC 3: Populate Dataset Values
INSERT INTO employee_payroll (name, salary, start_date) VALUES 
('Bill', 50000.00, '2018-01-01'),
('Terissa', 60000.00, '2019-05-10'),
('Charlie', 70000.00, '2020-11-15');

-- UC 4: Read All Records
SELECT * FROM employee_payroll;

-- UC 5: Filter Parameters via Range Functions
SELECT salary FROM employee_payroll WHERE name = 'Bill';
SELECT * FROM employee_payroll WHERE start_date BETWEEN CAST('2018-01-01' AS DATE) AND DATE(NOW());

-- UC 6: Add Column Fields and Restructure Values
ALTER TABLE employee_payroll ADD gender CHAR(1) AFTER name;
UPDATE employee_payroll SET gender = 'M' WHERE name IN ('Bill', 'Charlie');
UPDATE employee_payroll SET gender = 'F' WHERE name = 'Terissa';

-- UC 7: Process Mathematical Aggregates Grouped by Field Elements
SELECT gender, SUM(salary), AVG(salary), MIN(salary), MAX(salary), COUNT(id) 
FROM employee_payroll 
GROUP BY gender;